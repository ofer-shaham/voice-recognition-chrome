# Optional: HTTP proxy used by youtube-transcript-api-js (provider/method 2).
# Use an http:// or https:// URL; keep credentials in Replit Secrets.
YOUTUBE_HTTP_PROXY=
# Invidious is enabled by default as a fallback when YouTube transcript access fails.
# Set to false to disable it, or provide a comma-separated instance list.
YOUTUBE_INVIDIOUS_ENABLED=true
YOUTUBE_INVIDIOUS_INSTANCES=https://yewtu.be
# Copy to .env and fill in your values.
# Used by docker-compose and manage.sh native mode.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
